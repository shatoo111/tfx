{
  "version": 5,
  "configurePresets": [
    {"name": "desktop", "generator": "Ninja", "binaryDir": "${sourceDir}/build/desktop", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON"}},
    {"name": "core", "generator": "Ninja", "binaryDir": "${sourceDir}/build/core", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "TE_BUILD_APP": "OFF", "BUILD_TESTING": "ON"}}
  ],
  "buildPresets": [{"name": "desktop", "configurePreset": "desktop"}, {"name": "core", "configurePreset": "core"}],
  "testPresets": [{"name": "desktop", "configurePreset": "desktop", "output": {"outputOnFailure": true}}, {"name": "core", "configurePreset": "core", "output": {"outputOnFailure": true}}]
}
